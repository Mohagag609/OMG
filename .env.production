# Production Environment Variables for Netlify
# Database Configuration
DATABASE_TYPE=postgresql-cloud

# Database URLs - سيتم تعيينها في Netlify Environment Variables
DATABASE_URL_POSTGRES_CLOUD=${DATABASE_URL}
DATABASE_URL_POSTGRES_LOCAL=postgresql://postgres:password@localhost:5432/estate_pro_db
DATABASE_URL_SQLITE=file:./prisma/dev.db

# Fallback (used if specific URL not set)
DATABASE_URL=${DATABASE_URL}

# Application Configuration
APP_VERSION=1.0.0
PRISMA_MIGRATION_ID=latest

# Security
ALLOW_HARD_WIPE=false

# JWT Configuration
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=7d

# API Configuration
API_BASE_URL=${NEXT_PUBLIC_API_URL}
NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# Admin Key
NEXT_PUBLIC_ADMIN_KEY=${NEXT_PUBLIC_ADMIN_KEY}

# Production Settings
NODE_ENV=production
PORT=3000

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

# Feature Flags
ENABLE_AUDIT_LOGS=true
ENABLE_NOTIFICATIONS=true
ENABLE_BACKUP_AUTOMATION=true

# NextAuth
NEXTAUTH_SECRET=${NEXTAUTH_SECRET}